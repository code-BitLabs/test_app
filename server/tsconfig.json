{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../src/*"],
      "@server/*": ["./src/*"],
      "@domain/*": ["../src/domain/*"]
    },
    "noEmit": true
  },
  "include": ["src/**/*", "__tests__/**/*"]
}
